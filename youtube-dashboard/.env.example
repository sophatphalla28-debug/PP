# ─── Copy to .env.local for local development. On Vercel, add these in
# ─── Project → Settings → Environment Variables. Never commit real values.

# Postgres connection string (Supabase: Project → Connect → "Transaction pooler", port 6543).
# POSTGRES_URL is also accepted (set automatically by the Vercel ↔ Supabase integration).
DATABASE_URL=

# Public URL of this dashboard, no trailing slash. Used to build the OAuth redirect URI:
#   ${APP_URL}/api/auth/callback   ← add exactly this in Google Cloud → Credentials.
APP_URL=http://localhost:3000

# Google Cloud → APIs & Services → Credentials → OAuth client ID (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google account emails allowed to open the dashboard.
ALLOWED_EMAILS=you@example.com

# Generate all three with:  npm run gen:keys
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
